.DS_Store

# Локальные инструменты (Impeccable/Claude Code/Codex) — машинно-специфичные, переустанавливаются командой,
# не версионируем, чтобы не тащить в историю репозитория чужую конфигурацию инструментов.
# Исключение: .claude/commands/ — это общие slash-команды проекта, версионируются осознанно (см. ниже).
.agents/
.claude/*
!.claude/commands/
.codex/
.impeccable/

# Секреты (ключи API и т.п.) — никогда не версионировать.
.env

# Продуктовые документы (PRODUCT.md, DESIGN.md), сгенерированные Impeccable, — НЕ игнорировать,
# это контент проекта и должен версионироваться как обычно.
scripts/__pycache__/
__pycache__/
